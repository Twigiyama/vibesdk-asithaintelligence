		"cloudflare": "^4.5.0",
		"cmdk": "^1.1.1",
		"cross-spawn": "^7.0.6",
		"date-fns": "^4.4.0",
		"diff": "^8.0.2",
		"drizzle-orm": "^0.45.4",
		"embla-carousel-react": "^8.6.0",
		"esbuild": "^0.28.2",
		"eslint-import-resolver-typescript": "^4.4.5",
		"eslint-plugin-import": "^2.32.0",
		"fflate": "^0.8.2",
		"framer-motion": "^12.42.2",
		"hash-wasm": "^4.12.0",
		"hono": "^4.13.13",
		"html2canvas-pro": "^1.5.13",
		"htmlparser2": "^10.0.0",
		"idb-keyval": "^6.3.0",
		"inquirer": "^12.11.1",
		"jose": "^5.10.0",
		"jsonc-parser": "^3.3.1",
		"lucide-react": "^0.541.0",
		"mdast-util-to-string": "^4.0.0",
		"monaco-editor": "^0.57.0",
		"nanoid": "^5.1.6",
		"openai": "^5.23.2",
		"ora": "^9.4.1",
		"partysocket": "^1.3.0",
		"react": "^19.3.1",
		"react-day-picker": "^9.12.0",
		"react-dom": "^19.3.1",
		"react-hook-form": "^7.90.0",
		"react-markdown": "^10.1.0",
		"react-resizable-panels": "^3.0.6",
		"react-router": "^7.10.1",
		"recharts": "^3.10.1",
		"rehype-external-links": "^3.0.0",
		"remark-gfm": "^4.0.1",
		"remark-parse": "^11.0.0",
		"sonner": "^2.0.8",
		"unified": "^11.0.5",
		"vaul": "^1.1.2",
		"vite-plugin-svgr": "^4.5.0",
		"ws": "^8.22.0",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "^1.64.0",
		"@cloudflare/vitest-pool-workers": "^0.23.0",
		"@cloudflare/workers-types": "4.20251213.0",
		"@commitlint/cli": "20.5.3",
		"@eslint/js": "^9.39.2",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.3",
		"@types/jest": "^29.5.14",
		"@types/node": "^22.19.3",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitest/coverage-v8": "^3.2.4",
		"drizzle-kit": "^0.31.11",
		"eslint": "^9.39.2",
		"eslint-plugin-react-hooks": "^5.2.0",
		"eslint-plugin-react-refresh": "^0.5.7",
		"globals": "^17.13.0",
		"husky": "^9.1.7",
		"jest": "^29.7.0",
		"knip": "^5.73.4",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"puppeteer": "^24.0.0",
		"tailwindcss": "^4.3.3",
		"tsx": "^4.23.15",
		"tw-animate-css": "^1.4.0",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.71.2",
		"vite": "^8.3.4",
		"vitest": "^3.2.4",
		"wrangler": "4.151.1"
	},
	"prettier": {
		"singleQuote": true,
		"useTabs": true
	},
	"overrides": {
		"@cloudflare/containers": "^0.0.28"
	}
}
